# ==============================================================================
# Bug-feed Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=9600
HOST=0.0.0.0
NODE_ENV=production

# Automated Threat Ingestion Pipeline
# Specifies how often (in minutes) the background worker polls remote security sources
# Recommended: between 10 and 30 minutes
SYNC_INTERVAL_MINUTES=15

# Authentication & Session Security
# Set a custom strong random secret key for HMAC-SHA256 session token signing.
# If omitted, Bug-feed generates a cryptographically secure random secret on first run.
AUTH_SECRET=replace_with_a_secure_random_string_min_32_characters

# Data Persistence (Optional)
# Directory where database JSON files are stored. Defaults to ./backend/data
# DATA_DIR=./backend/data
