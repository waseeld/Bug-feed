# ==============================================================================
# Bug-feed Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
# HOST is optional; leave it unset to listen on every interface.
PORT=9600
HOST=0.0.0.0
NODE_ENV=production

# Automated Threat Ingestion Pipeline
# Specifies how often (in minutes) the background worker polls remote security sources
# Recommended: between 10 and 30 minutes
SYNC_INTERVAL_MINUTES=15

# Authentication & Session Security
# Secret key for HMAC-SHA256 session token signing (at least 32 random characters).
# Leave it empty and Bug-feed generates a random secret on first run and keeps it in
# <DATA_DIR>/secret.key, so sessions survive restarts. Never reuse an example value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Data Persistence (Optional)
# Directory where database JSON files and secret.key are stored. Defaults to ./backend/data
# DATA_DIR=./backend/data
